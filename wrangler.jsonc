{
  // One Worker serves the whole site: the built SPA as static assets, the
  // public form API, the unsubscribe page, and the admin portal at /admin.
  // Deploy with `npm run deploy` (which builds the site first).
  "name": "cohere-signup",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-06-09",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router owns the URL space, so unknown paths get index.html.
    "not_found_handling": "single-page-application",
    // The Worker routes first and falls through to assets, so /api/*, /admin
    // and /unsubscribe are never shadowed by a similarly named file.
    "run_worker_first": true
  },

  // Kept on so the workers.dev URL stays available for testing a deploy
  // before checking it on the real domain.
  "workers_dev": true,

  // Cloudflare manages the DNS records and certificates for both hostnames.
  "routes": [
    { "pattern": "cohereboulder.org", "custom_domain": true },
    { "pattern": "www.cohereboulder.org", "custom_domain": true }
  ],

  "kv_namespaces": [
    { "binding": "SIGNUPS", "id": "e7cb04113ed14308bff4b85dbbe35ac7" },
    { "binding": "COHERE_AUTH", "id": "2fbaac0edc1f494ea87a7cb752be7ce1" }
  ],
  "send_email": [{ "name": "SEND_EMAIL" }],
  "vars": {
    // Where emailed sign-in links point.
    "PUBLIC_BASE_URL": "https://cohereboulder.org",
    "MAIL_FROM": "COhere Boulder <cohere@wovenweb.org>",
    // The community calendar reads from regenOS (worker/src/events.ts).
    // The COhere Boulder scene, minted 2026-08-30:
    //   https://scenius.social/scenes/did:plc:w54s52ycbw5lreyhlzexredb
    // If it is ever unreachable or empty the site falls back to the Luma embed.
    "REGENOS_COLLECTIVE_DID": "did:plc:w54s52ycbw5lreyhlzexredb",
    "REGENOS_BASE_URL": "https://scenius.social",
    "REGENOS_WEB_URL": "https://scenius.social"
  },
  "d1_databases": [
    {
      "binding": "cohere",
      "database_name": "cohere",
      "database_id": "9eaac080-fe20-4124-8719-452091797866",
      // Schema changes ship as numbered files here; the deploy workflow runs
      // `wrangler d1 migrations apply cohere --remote` before every deploy.
      "migrations_dir": "worker/migrations"
    }
  ]
}
