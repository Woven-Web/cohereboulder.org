# Local development only. The site has no backend of its own — everything
# server-side lives in the Cloudflare Worker (see wrangler.jsonc).

# Unset means same-origin, which is correct in production (the Worker serves
# both the site and the API) and when running `npm run worker:dev`.
# Set this only when running `npm run dev` against a deployed Worker:
# VITE_SIGNUP_URL=https://cohereboulder.org
