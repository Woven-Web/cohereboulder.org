# Local development only. The site has no backend of its own — everything
# server-side lives in the Cloudflare Worker (see wrangler.jsonc).

# Where the forms POST. Leave unset to use the deployed Worker.
# Set to http://localhost:8787 to develop against a local `npm run worker:dev`.
# Once the site is served by the Worker on its own domain, set it to an empty
# string so the site uses same-origin relative paths.
VITE_SIGNUP_URL=https://cohere-signup.unforced.workers.dev
